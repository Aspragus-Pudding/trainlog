{
  "about": "Movement tags: what a movement asks of a joint, independent of family or pattern. Injury entries list the tags they avoid; an exercise carries the tags its typical execution has. Tagged sparingly on purpose — a tag means the exercise really puts the joint there under load, not that it could. Judgement defaults, hand-assigned (Oct 2026).",
  "tags": {
    "shoulder_abd_er_loaded": "Arm out to the side and rotated back under load (the 'high-five' position): behind-the-neck work, wide-grip pressing at the bottom, flyes.",
    "shoulder_horiz_abd_endrange": "Elbows travelling behind the torso at the bottom of a free-weight press or fly.",
    "shoulder_ext_endrange_loaded": "Arm driven behind the body under load, as at the bottom of a dip.",
    "shoulder_overhead_loaded": "Pressing or holding a load overhead.",
    "shoulder_overhead_endrange": "Shoulder taken to full overhead flexion under load or stretch (pullover, overhead triceps).",
    "shoulder_elevation_abd": "Arm raised out to the side towards shoulder height under load.",
    "shoulder_hang_traction": "Hanging or pulling from a full overhead hang.",
    "elbow_ext_endrange_loaded": "Elbow locking out under load — the joint, not the muscle, takes the last few degrees.",
    "ballistic_elbow_ext": "Fast, uncontrolled elbow extension under load (snatches, swings with a locked arm).",
    "elbow_flex_loaded_heavy": "Heavy elbow flexion: curls, chin-ups.",
    "max_grip_wrist_ext": "Maximal or long gripping, especially with the wrist bent back: heavy holds, carries, hangs.",
    "wrist_ext_loaded": "Wrist bent back under load: pressing, front rack, push-ups.",
    "wrist_direct_loaded": "Load taken directly by the wrist flexors or extensors: wrist curls, rollers.",
    "spine_axial_heavy": "A heavy load compressing the spine: a bar on the back, a heavy pull or carry.",
    "spine_flex_loaded": "Rounding the lower back under load.",
    "spine_ext_endrange_loaded": "Arching the lower back to end range under load.",
    "hinge_heavy": "A heavy hip hinge with the trunk inclined and the load hanging from the arms or across the back.",
    "hip_flex_deep_loaded": "Deep hip flexion under load: the bottom of a deep squat or leg press.",
    "hip_adduction_compression": "The hip pulled across the midline under load or compression (gluteal tendon compression).",
    "hamstring_lengthened_loaded": "Hamstrings loaded at long length: RDLs, good mornings, nordics.",
    "knee_flex_deep_loaded": "Deep knee bend under load.",
    "knee_ext_open_chain": "Knee straightening against a pad or cable with the foot free (leg extension).",
    "knee_ext_endrange_loaded": "Knee locking out under load.",
    "ankle_df_deep_loaded": "Shin far forward over the foot under load: the bottom of a deep squat, a loaded calf stretch.",
    "calf_endrange_loaded": "Calf loaded through its full stretch and rise.",
    "plyo_jump_landing": "Jumping and landing.",
    "calf_plyo": "Hops, skips and bounds — springy calf loading.",
    "ballistic_endrange": "Fast movement that ends at end of range.",
    "passive_endrange_stretch": "Holding a joint at the end of its range with no muscle control (deep static stretches, dislocates).",
    "run_speed_cutting": "Sprinting and changing direction (running — not carried by any gym exercise).",
    "run_hills_sprints": "Hill running and sprints (running).",
    "run_volume_spike": "A sudden jump in running volume (running).",
    "run_impact": "Running impact in general (running)."
  },
  "running_tags": [
    "run_speed_cutting",
    "run_hills_sprints",
    "run_volume_spike",
    "run_impact"
  ],
